<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Mental Toughness Institute</title>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
:root {
  --obsidian: #0a0a0b;
  --charcoal: #111114;
  --steel: #1a1a20;
  --muted: #2c2c35;
  --border: rgba(255,255,255,0.08);
  --orange: #f26419;
  --orange-light: #ff8c4b;
  --orange-dim: rgba(242,100,25,0.12);
  --white: #f5f3ee;
  --gray: #8a8a96;
}
html { scroll-behavior: smooth; }
body { background: var(--obsidian); color: var(--white); font-family: 'DM Sans', sans-serif; font-weight: 300; line-height: 1.7; overflow-x: hidden; }

/* NAV */
nav {
  position: fixed; top: 0; left: 0; right: 0; z-index: 200;
  background: rgba(10,10,11,0.92); backdrop-filter: blur(20px);
  border-bottom: 1px solid var(--border);
  padding: 0 3rem;
  display: flex; align-items: center; justify-content: space-between;
  height: 70px;
}
.nav-logo img { height: 44px; object-fit: contain; }
.nav-logo span { font-family: 'Bebas Neue', sans-serif; font-size: 1.4rem; letter-spacing: 0.15em; color: var(--orange); }
.nav-links { display: flex; gap: 0; list-style: none; }
.nav-links li a {
  font-size: 0.7rem; letter-spacing: 0.1em; text-transform: uppercase;
  color: var(--gray); text-decoration: none; padding: 0.5rem 0.9rem;
  transition: color 0.3s; display: block;
}
.nav-links li a:hover { color: var(--orange); }
.hamburger { display: none; flex-direction: column; gap: 5px; cursor: pointer; padding: 5px; }
.hamburger span { width: 24px; height: 1.5px; background: var(--white); transition: 0.3s; }
.mobile-menu { display: none; position: fixed; top: 70px; left: 0; right: 0; bottom: 0; background: var(--obsidian); z-index: 199; padding: 2rem; overflow-y: auto; }
.mobile-menu.open { display: block; }
.mobile-menu a { display: block; font-size: 1.4rem; font-family: 'Bebas Neue', sans-serif; letter-spacing: 0.1em; color: var(--white); text-decoration: none; padding: 1rem 0; border-bottom: 1px solid var(--border); transition: color 0.3s; }
.mobile-menu a:hover { color: var(--orange); }

/* SECTION SHARED */
section { scroll-margin-top: 70px; }
.section-inner { max-width: 1200px; margin: 0 auto; padding: 0 3rem; }
.section-label {
  font-size: 0.65rem; letter-spacing: 0.25em; text-transform: uppercase;
  color: var(--orange); margin-bottom: 1rem;
  display: flex; align-items: center; gap: 0.8rem;
}
.section-label::after { content: ''; display: block; width: 28px; height: 1px; background: var(--orange); }
h2.section-title {
  font-family: 'Bebas Neue', sans-serif;
  font-size: clamp(2.8rem, 4.5vw, 5rem);
  line-height: 1; letter-spacing: 0.03em; color: var(--white); margin-bottom: 1.5rem;
}
h2.section-title span { color: var(--orange); }
.divider { width: 50px; height: 2px; background: var(--orange); margin: 0 auto 3rem; }

/* HERO */
#home {
  min-height: 100vh; position: relative; overflow: hidden;
  display: flex; align-items: center;
}
.hero-bg {
  position: absolute; inset: 0;
  background-image: url('data:image/jpeg;base64,');
  background-size: cover; background-position: center top;
  filter: brightness(0.35);
}
.hero-overlay {
  position: absolute; inset: 0;
  background: linear-gradient(to right, rgba(10,10,11,0.85) 45%, rgba(10,10,11,0.3) 100%),
              linear-gradient(to top, rgba(10,10,11,0.7) 0%, transparent 50%);
}
.hero-content {
  position: relative; z-index: 2;
  max-width: 1200px; margin: 0 auto; padding: 0 3rem;
  padding-top: 120px; padding-bottom: 80px;
}
.hero-tag {
  font-size: 0.68rem; letter-spacing: 0.25em; text-transform: uppercase;
  color: var(--orange); margin-bottom: 1.5rem;
  display: flex; align-items: center; gap: 1rem;
}
.hero-tag::before { content: ''; display: block; width: 36px; height: 1px; background: var(--orange); }
.hero-content h1 {
  font-family: 'Bebas Neue', sans-serif;
  font-size: clamp(4rem, 8vw, 9rem);
  line-height: 0.9; letter-spacing: 0.02em; color: var(--white); margin-bottom: 1rem;
}
.hero-content h1 em { color: var(--orange); font-style: normal; display: block; }
.hero-subtitle {
  font-family: 'Cormorant Garamond', serif; font-style: italic;
  font-size: 1.4rem; color: rgba(245,243,238,0.75); max-width: 520px;
  margin-bottom: 2rem; line-height: 1.6;
}
.hero-quote {
  font-family: 'Cormorant Garamond', serif; font-style: italic;
  font-size: 1.1rem; color: var(--gray); max-width: 460px;
  border-left: 2px solid var(--orange); padding-left: 1.2rem;
  margin-bottom: 2.5rem; line-height: 1.7;
}
.btn-primary {
  background: var(--orange); color: var(--obsidian);
  padding: 1rem 2.5rem; font-size: 0.78rem; font-weight: 500;
  letter-spacing: 0.12em; text-transform: uppercase;
  text-decoration: none; display: inline-block; transition: all 0.3s; cursor: pointer; border: none;
}
.btn-primary:hover { background: var(--orange-light); transform: translateY(-2px); }
.btn-ghost {
  color: var(--white); font-size: 0.78rem; letter-spacing: 0.12em;
  text-transform: uppercase; text-decoration: none; padding: 1rem 2rem;
  border: 1px solid var(--border); transition: all 0.3s; display: inline-block; cursor: pointer;
  margin-left: 1rem;
}
.btn-ghost:hover { border-color: var(--orange); color: var(--orange); }

/* MARQUEE */
.marquee-bar { background: var(--orange); padding: 0.9rem 0; overflow: hidden; }
.marquee-track { display: flex; gap: 3rem; animation: marquee 24s linear infinite; white-space: nowrap; }
.marquee-item { font-family: 'Bebas Neue', sans-serif; font-size: 1rem; letter-spacing: 0.15em; color: var(--obsidian); display: flex; align-items: center; gap: 1.5rem; flex-shrink: 0; }
.marquee-dot { width: 5px; height: 5px; background: var(--obsidian); border-radius: 50%; flex-shrink: 0; }
@keyframes marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }

/* OUR STORY */
#our-story { padding: 8rem 0; background: var(--charcoal); }
.story-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 6rem; align-items: center; }
.story-text p { font-size: 0.95rem; color: var(--gray); margin-bottom: 1.2rem; line-height: 1.95; }
.story-text p strong { color: var(--white); font-weight: 500; }
.story-pull {
  background: var(--steel); border: 1px solid var(--border); padding: 3rem;
  position: relative;
}
.story-pull::before {
  content: '"\';' font-family: 'Cormorant Garamond', serif; font-size: 7rem;
  color: var(--orange); opacity: 0.15; position: absolute; top: -1.5rem; left: 1.5rem; line-height: 1;
}
.story-pull blockquote {
  font-family: 'Cormorant Garamond', serif; font-style: italic;
  font-size: 1.55rem; color: var(--white); line-height: 1.5; margin-bottom: 1.5rem;
}
.story-pull cite { font-size: 0.72rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--orange); font-style: normal; }
.story-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: var(--border); margin-top: 2rem; }
.stat { background: var(--obsidian); padding: 2rem; text-align: center; }
.stat-num { font-family: 'Bebas Neue', sans-serif; font-size: 3.2rem; color: var(--orange); line-height: 1; display: block; }
.stat-lbl { font-size: 0.68rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--gray); margin-top: 0.3rem; }

/* WHY US */
#why-us { padding: 8rem 0; }
.why-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--border); margin-top: 4rem; }
.why-card {
  background: var(--obsidian); padding: 3rem 2.5rem;
  position: relative; transition: background 0.4s;
}
.why-card:hover { background: var(--steel); }
.why-num { font-family: 'Bebas Neue', sans-serif; font-size: 4rem; color: rgba(242,100,25,0.1); line-height: 1; margin-bottom: 1.5rem; transition: color 0.4s; }
.why-card:hover .why-num { color: rgba(242,100,25,0.3); }
.why-icon { width: 46px; height: 46px; border: 1px solid var(--orange); display: flex; align-items: center; justify-content: center; margin-bottom: 1.5rem; }
.why-icon svg { width: 20px; height: 20px; stroke: var(--orange); fill: none; stroke-width: 1.5; }
.why-card h3 { font-family: 'Bebas Neue', sans-serif; font-size: 1.5rem; letter-spacing: 0.05em; color: var(--white); margin-bottom: 1rem; }
.why-card p { font-size: 0.88rem; color: var(--gray); line-height: 1.85; }
.why-bar { position: absolute; bottom: 0; left: 0; height: 2px; width: 0; background: var(--orange); transition: width 0.5s; }
.why-card:hover .why-bar { width: 100%; }

/* OUR FOUNDER */
#our-founder { padding: 8rem 0; background: var(--charcoal); }
.founder-grid { display: grid; grid-template-columns: 1fr 1.4fr; gap: 6rem; align-items: center; }
.founder-img-wrap { position: relative; }
.founder-img-wrap::before {
  content: ''; position: absolute; top: -1.5rem; left: -1.5rem; right: 1.5rem; bottom: 1.5rem;
  border: 1px solid var(--orange); opacity: 0.3; z-index: 0;
}
.founder-img {
  width: 100%; aspect-ratio: 3/4; object-fit: cover; object-position: top;
  filter: grayscale(20%) contrast(1.05); position: relative; z-index: 1;
  display: block;
}
.founder-placeholder {
  width: 100%; aspect-ratio: 3/4; background: var(--steel);
  display: flex; align-items: center; justify-content: center;
  position: relative; z-index: 1;
}
.founder-placeholder span { font-family: 'Bebas Neue', sans-serif; font-size: 6rem; color: rgba(242,100,25,0.15); }
.founder-info .name { font-family: 'Bebas Neue', sans-serif; font-size: 3.5rem; letter-spacing: 0.05em; color: var(--white); line-height: 1; margin-bottom: 0.5rem; }
.founder-info .role { font-size: 0.72rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--orange); margin-bottom: 2rem; }
.founder-info p { font-size: 0.95rem; color: var(--gray); line-height: 1.95; margin-bottom: 1.2rem; }

/* SERVICES */
#services { padding: 8rem 0; }
.services-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; margin-top: 4rem; }
.service-card {
  background: var(--steel); border: 1px solid var(--border);
  padding: 2.5rem; transition: border-color 0.3s, transform 0.3s; position: relative; overflow: hidden;
}
.service-card::after {
  content: ''; position: absolute; bottom: 0; left: 0; height: 2px; width: 0;
  background: var(--orange); transition: width 0.5s;
}
.service-card:hover { border-color: rgba(242,100,25,0.4); transform: translateY(-4px); }
.service-card:hover::after { width: 100%; }
.service-card h3 { font-family: 'Bebas Neue', sans-serif; font-size: 1.5rem; letter-spacing: 0.05em; color: var(--white); margin-bottom: 1.2rem; line-height: 1.2; }
.service-card p { font-size: 0.88rem; color: var(--gray); line-height: 1.85; margin-bottom: 1.5rem; }
.service-tag { font-size: 0.62rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--orange); }

/* SHOP */
#shop { padding: 8rem 0; background: var(--charcoal); }
.shop-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--border); margin-top: 4rem; }
.shop-card {
  background: var(--charcoal); padding: 3rem 2rem; text-align: center;
  transition: background 0.3s; cursor: pointer;
}
.shop-card:hover { background: var(--steel); }
.shop-icon { width: 56px; height: 56px; border: 1px solid var(--orange); margin: 0 auto 1.5rem; display: flex; align-items: center; justify-content: center; }
.shop-icon svg { width: 24px; height: 24px; stroke: var(--orange); fill: none; stroke-width: 1.5; }
.shop-card h3 { font-family: 'Bebas Neue', sans-serif; font-size: 1.3rem; letter-spacing: 0.08em; color: var(--white); margin-bottom: 0.8rem; }
.shop-card p { font-size: 0.82rem; color: var(--gray); line-height: 1.7; }

/* EVENTS */
#events { padding: 8rem 0; }
.events-list { display: flex; flex-direction: column; gap: 1px; background: var(--border); margin-top: 4rem; }
.event-row {
  background: var(--obsidian); padding: 2.5rem 3rem;
  display: grid; grid-template-columns: 100px 1fr auto;
  gap: 2.5rem; align-items: center; transition: background 0.3s;
}
.event-row:hover { background: var(--steel); }
.event-date-box { text-align: center; }
.event-day { font-family: 'Bebas Neue', sans-serif; font-size: 3rem; color: var(--orange); line-height: 1; }
.event-mon { font-size: 0.68rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--gray); }
.event-title { font-family: 'Bebas Neue', sans-serif; font-size: 1.5rem; letter-spacing: 0.05em; color: var(--white); margin-bottom: 0.4rem; }
.event-meta { font-size: 0.82rem; color: var(--gray); }
.event-meta span { color: var(--orange); margin-right: 1rem; }
.event-price { font-family: 'Bebas Neue', sans-serif; font-size: 1.8rem; color: var(--orange); }
.event-price.free { color: var(--gray); font-size: 1.2rem; letter-spacing: 0.08em; }

/* TESTIMONIALS */
#testimonials { padding: 8rem 0; background: var(--charcoal); position: relative; overflow: hidden; }
#testimonials::before {
  content: '"'; font-family: 'Cormorant Garamond', serif; font-size: 40vw;
  color: rgba(242,100,25,0.03); position: absolute; top: -5vw; left: -3vw;
  line-height: 1; pointer-events: none;
}
.testimonials-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; margin-top: 4rem; }
.testi-card {
  background: var(--steel); border: 1px solid var(--border);
  padding: 2.5rem; position: relative; transition: border-color 0.3s;
}
.testi-card:hover { border-color: rgba(242,100,25,0.3); }
.testi-card::before {
  content: '"'; font-family: 'Cormorant Garamond', serif; font-size: 3.5rem;
  color: var(--orange); opacity: 0.3; line-height: 1; display: block; margin-bottom: 0.5rem;
}
.testi-card blockquote { font-size: 0.88rem; color: var(--gray); line-height: 1.85; margin-bottom: 1.5rem; font-style: italic; }
.testi-name { font-family: 'Bebas Neue', sans-serif; font-size: 1.1rem; letter-spacing: 0.08em; color: var(--white); }
.testi-role { font-size: 0.7rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--orange); margin-top: 0.2rem; }

/* BLOG */
#blog { padding: 8rem 0; }
.blog-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2rem; margin-top: 4rem; }
.blog-card {
  background: var(--steel); border: 1px solid var(--border);
  padding: 2.5rem; transition: border-color 0.3s, transform 0.3s;
}
.blog-card:hover { border-color: rgba(242,100,25,0.4); transform: translateY(-3px); }
.blog-date { font-size: 0.68rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--orange); margin-bottom: 0.8rem; }
.blog-card h3 { font-family: 'Bebas Neue', sans-serif; font-size: 1.4rem; letter-spacing: 0.05em; color: var(--white); margin-bottom: 0.8rem; line-height: 1.2; }
.blog-link { font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--orange); text-decoration: none; transition: gap 0.3s; display: flex; align-items: center; gap: 0.4rem; margin-top: 1.2rem; }
.blog-link:hover { gap: 0.8rem; }

/* CONTACT */
#contact { padding: 8rem 0; background: var(--charcoal); }
.contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 6rem; align-items: start; margin-top: 4rem; }
.contact-info { }
.contact-info h3 { font-family: 'Bebas Neue', sans-serif; font-size: 2rem; letter-spacing: 0.05em; color: var(--white); margin-bottom: 2rem; }
.contact-item { display: flex; align-items: flex-start; gap: 1.2rem; margin-bottom: 1.5rem; }
.contact-item-icon { width: 42px; height: 42px; border: 1px solid var(--orange); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.contact-item-icon svg { width: 18px; height: 18px; stroke: var(--orange); fill: none; stroke-width: 1.5; }
.contact-item-label { font-size: 0.65rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--orange); margin-bottom: 0.3rem; }
.contact-item-val { font-size: 0.92rem; color: var(--white); }
.contact-form { display: flex; flex-direction: column; gap: 1.2rem; }
.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem; }
.form-group { display: flex; flex-direction: column; gap: 0.4rem; }
.form-group label { font-size: 0.68rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--gray); }
.form-group input, .form-group textarea {
  background: var(--steel); border: 1px solid var(--border); color: var(--white);
  padding: 0.9rem 1.1rem; font-family: 'DM Sans', sans-serif; font-size: 0.9rem;
  outline: none; transition: border-color 0.3s; width: 100%;
}
.form-group input:focus, .form-group textarea:focus { border-color: var(--orange); }
.form-group textarea { height: 140px; resize: vertical; }
.btn-submit {
  background: var(--orange); color: var(--obsidian); padding: 1rem 2.5rem;
  font-family: 'DM Sans', sans-serif; font-size: 0.78rem; font-weight: 500;
  letter-spacing: 0.12em; text-transform: uppercase; border: none; cursor: pointer;
  transition: all 0.3s; align-self: flex-start;
}
.btn-submit:hover { background: var(--orange-light); transform: translateY(-2px); }

/* CTA BAND */
.cta-band {
  background: var(--orange); padding: 5rem 3rem; text-align: center;
  position: relative; overflow: hidden;
}
.cta-band::before {
  content: 'UNSHAKABLE'; font-family: 'Bebas Neue', sans-serif; font-size: 16vw;
  color: rgba(10,10,11,0.07); position: absolute; top: 50%; left: 50%;
  transform: translate(-50%, -50%); white-space: nowrap; pointer-events: none;
}
.cta-band h2 { font-family: 'Bebas Neue', sans-serif; font-size: clamp(3rem, 5vw, 6rem); color: var(--obsidian); margin-bottom: 1rem; position: relative; }
.cta-band p { font-family: 'Cormorant Garamond', serif; font-style: italic; font-size: 1.3rem; color: rgba(10,10,11,0.6); max-width: 500px; margin: 0 auto 2.5rem; position: relative; }
.btn-dark { background: var(--obsidian); color: var(--orange); padding: 1rem 3rem; font-size: 0.78rem; font-weight: 500; letter-spacing: 0.15em; text-transform: uppercase; border: none; cursor: pointer; transition: all 0.3s; }
.btn-dark:hover { background: var(--steel); transform: translateY(-2px); }

/* FOOTER */
footer { background: var(--obsidian); border-top: 1px solid var(--border); padding: 3rem; }
.footer-inner { max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 3rem; }
.footer-brand p { font-size: 0.85rem; color: var(--gray); line-height: 1.8; max-width: 260px; margin-top: 0.8rem; }
.footer-col h5 { font-size: 0.65rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--orange); margin-bottom: 1.2rem; }
.footer-col ul { list-style: none; }
.footer-col li { margin-bottom: 0.7rem; }
.footer-col a { font-size: 0.83rem; color: var(--gray); text-decoration: none; transition: color 0.3s; }
.footer-col a:hover { color: var(--white); }
.footer-bottom { max-width: 1200px; margin: 2.5rem auto 0; padding-top: 1.5rem; border-top: 1px solid var(--border); display: flex; justify-content: space-between; font-size: 0.72rem; color: var(--gray); }

/* FADE-IN */
.fade-in { opacity: 0; transform: translateY(28px); transition: opacity 0.75s ease, transform 0.75s ease; }
.fade-in.visible { opacity: 1; transform: translateY(0); }

/* RESPONSIVE */
@media (max-width: 1024px) {
  .founder-grid { grid-template-columns: 1fr 1.2fr; gap: 3rem; }
}
@media (max-width: 900px) {
  nav { padding: 0 1.5rem; }
  .nav-links { display: none; }
  .hamburger { display: flex; }
  .section-inner { padding: 0 1.5rem; }
  .hero-content { padding: 100px 1.5rem 60px; }
  .story-grid, .founder-grid, .contact-grid { grid-template-columns: 1fr; gap: 3rem; }
  .why-grid, .services-grid { grid-template-columns: 1fr; }
  .shop-grid { grid-template-columns: 1fr 1fr; }
  .testimonials-grid { grid-template-columns: 1fr; }
  .blog-grid { grid-template-columns: 1fr; }
  .footer-inner { grid-template-columns: 1fr 1fr; gap: 2rem; }
  .event-row { grid-template-columns: 80px 1fr; }
  .event-price { display: none; }
  .form-row { grid-template-columns: 1fr; }
}
@media (max-width: 600px) {
  .shop-grid { grid-template-columns: 1fr; }
  .footer-inner { grid-template-columns: 1fr; }
}
</style>
</head>
<body>

<!-- NAV -->
<nav id="main-nav">
  <a class="nav-logo" href="#home">
    <span>Mental Toughness Institute</span>
  </a>
  <ul class="nav-links">
    <li><a href="#home">Home</a></li>
    <li><a href="#our-story">Our Story</a></li>
    <li><a href="#why-us">Why Us?</a></li>
    <li><a href="#our-founder">Our Founder</a></li>
    <li><a href="#services">Services</a></li>
    <li><a href="#shop">Shop</a></li>
    <li><a href="#events">Events</a></li>
    <li><a href="#testimonials">Testimonials</a></li>
    <li><a href="#blog">Blog</a></li>
    <li><a href="#contact">Contact</a></li>
  </ul>
  <div class="hamburger" onclick="toggleMenu()" id="hamburger">
    <span></span><span></span><span></span>
  </div>
</nav>
<div class="mobile-menu" id="mobile-menu">
  <a href="#home" onclick="closeMenu()">Home</a>
